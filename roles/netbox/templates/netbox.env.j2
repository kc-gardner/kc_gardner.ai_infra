# {{ ansible_managed }}
ALLOWED_HOSTS={{ netbox_server_names_clean | join(' ') }}
CSRF_TRUSTED_ORIGINS={{ netbox_origins | join(' ') }}
SECRET_KEY={{ netbox_secret_key }}
API_TOKEN_PEPPER_1={{ netbox_api_token_pepper }}
DB_HOST=netbox-postgres
DB_NAME={{ netbox_db_name }}
DB_USER={{ netbox_db_user }}
DB_PASSWORD={{ netbox_db_password }}
REDIS_HOST=netbox-valkey
REDIS_DATABASE=0
REDIS_CACHE_HOST=netbox-valkey
REDIS_CACHE_DATABASE=1
TIME_ZONE={{ netbox_time_zone }}
GRANIAN_WORKERS={{ netbox_workers }}
{% if netbox_superuser_password | length > 0 %}
SKIP_SUPERUSER=false
SUPERUSER_NAME={{ netbox_superuser_name }}
SUPERUSER_EMAIL={{ netbox_superuser_email }}
SUPERUSER_PASSWORD={{ netbox_superuser_password }}
{% else %}
SKIP_SUPERUSER=true
{% endif %}
{% for name, value in netbox_env | dictsort %}
{{ name }}={{ value }}
{% endfor %}
