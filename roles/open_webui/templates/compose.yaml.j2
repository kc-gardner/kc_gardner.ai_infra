# {{ ansible_managed }}
name: {{ open_webui_name }}

services:
  open-webui:
    image: {{ open_webui_image }}
    container_name: {{ open_webui_name }}
    restart: unless-stopped
    env_file: open-webui.env
    ports:
      - "{{ open_webui_port }}:8080"
    # Lets the container reach services on the host, such as vLLM, by name.
    extra_hosts:
      - host.docker.internal:host-gateway
    volumes:
      - data:/app/backend/data
    # The image has its own healthcheck on /health.

volumes:
  data:
    name: {{ open_webui_volume }}
    external: true
