# {{ ansible_managed }}
# Open WebUI saves most settings in its database the first time it starts and
# ignores these variables for them afterwards. Change them in Admin Settings.
# WEBUI_SECRET_KEY is read on every start.
WEBUI_SECRET_KEY={{ open_webui_secret_key }}
ENABLE_OLLAMA_API={{ open_webui_enable_ollama | bool | lower }}
{% if open_webui_openai_connections | length > 0 %}
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URLS={{ open_webui_openai_connections | map(attribute='url') | join(';') }}
OPENAI_API_KEYS={{ open_webui_openai_connections | map(attribute='key', default='') | join(';') }}
{% endif %}
{% for name, value in open_webui_env | dictsort %}
{{ name }}={{ value }}
{% endfor %}
