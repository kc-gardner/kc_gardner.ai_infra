// {{ ansible_managed }}
// Overrides /etc/apt/apt.conf.d/50unattended-upgrades. #clear empties a list
// set by an earlier file, so these replace the package's defaults.

#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Allowed-Origins {
{% for origin in ubuntu_updates_unattended_origins %}
        "{{ origin }}";
{% endfor %}
};

#clear Unattended-Upgrade::Package-Blacklist;
Unattended-Upgrade::Package-Blacklist {
{% for package in ubuntu_updates_unattended_blacklist %}
        "{{ package }}";
{% endfor %}
};

Unattended-Upgrade::Automatic-Reboot "{{ ubuntu_updates_automatic_reboot | bool | lower }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ ubuntu_updates_automatic_reboot_time }}";
{% if ubuntu_updates_mail | length > 0 %}

Unattended-Upgrade::Mail "{{ ubuntu_updates_mail }}";
Unattended-Upgrade::MailReport "{{ ubuntu_updates_mail_report }}";
{% endif %}
