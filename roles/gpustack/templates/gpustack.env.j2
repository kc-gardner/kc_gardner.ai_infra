# {{ ansible_managed }}
{% if gpustack_bootstrap_password | length > 0 %}
GPUSTACK_BOOTSTRAP_PASSWORD={{ gpustack_bootstrap_password }}
{% endif %}
{% if gpustack_server_external_url | length > 0 %}
GPUSTACK_SERVER_EXTERNAL_URL={{ gpustack_server_external_url }}
{% endif %}
{% for key, value in gpustack_env | dictsort %}
{{ key }}={{ value }}
{% endfor %}
